START_URL=https://example.com

REQUEST_TIMEOUT=15
MAX_RETRIES=3
RETRY_BACKOFF=0.5
MAX_PAGES=10000
MAX_DEPTH=20
MAX_CONCURRENCY=5

# Global minimum delay between HTTP requests, in seconds.
CRAWL_DELAY=0.1

USER_AGENT=WebsiteURLCrawler/1.0

ALLOW_SUBDOMAINS=false
KEEP_QUERY_PARAMS=false

RESPECT_ROBOTS_TXT=true
ENABLE_SITEMAP=true
ENABLE_PLAYWRIGHT=false

VERIFY_SSL=true
MAX_RESPONSE_BYTES=5000000

OUTPUT_DIR=output
